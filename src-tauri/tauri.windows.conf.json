{
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../native/bin/windows-x64/": "bin/windows-x64/",
      "../native/drivers/windows-x64/": "drivers/windows-x64/",
      "../make/windows/install-tap-driver.ps1": "windows/install-tap-driver.ps1"
    },
    "windows": {
      "minimumWebview2Version": "111.0.0.0",
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "../make/windows/installer-hooks.nsh",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
