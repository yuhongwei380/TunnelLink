{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVPNClient",
  "version": "3.11.8",
  "identifier": "com.example.openvpn-client-phoenix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:35198",
    "beforeBuildCommand": "npm run build && node build/prepare-tauri.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenVPNClient",
        "width": 840,
        "height": 640,
        "minWidth": 840,
        "minHeight": 640,
        "maxWidth": 840,
        "maxHeight": 640,
        "resizable": false,
        "maximizable": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "licenseFile": "../resources/legal/USER-AGREEMENT.rtf",
    "resources": {
      "../resources/legal/": "legal/",
      "../LICENSES/": "legal/licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
