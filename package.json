{
  "name": "openvpnclient",
  "private": true,
  "version": "3.11.8",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=35198 --strictPort --host=127.0.0.1",
    "tauri:dev": "node make/tauri.mjs dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "node make/tauri.mjs",
    "clean": "rimraf dist make/dist",
    "format": "prettier --write src build scripts tests README.md docs install.mjs index.html vite.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check src build scripts tests README.md docs install.mjs index.html vite.config.ts tsconfig.json package.json .prettierrc.json",
    "check": "npm run format:check && npm run lint && npm run check:stack && npm run test:ui && npm run test:packaging && npm run test:unified",
    "lint": "tsc --noEmit",
    "check:stack": "node make/verify-desktop-stack.mjs",
    "check:native": "node make/tauri.mjs cargo check --manifest-path src-tauri/Cargo.toml",
    "test:ui": "node --import tsx --test make/tests/ui/*.test.ts",
    "test:native": "node make/tauri.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "test:packaging": "node --test make/tests/*.test.mjs",
    "test:windows-packaging": "node --test make/tests/windows-packaging.test.mjs",
    "test:macos-packaging": "node --test make/tests/macos-packaging.test.mjs",
    "test:packaging:integration": "node --test make/tests/integration/*.test.mjs",
    "sync:branding": "node make/sync-branding.mjs",
    "icons:generate": "node make/generate-icons.mjs",
    "build:openvpn3:win": "powershell -ExecutionPolicy Bypass -File make/windows/build-openvpn3.ps1",
    "build:openvpn3:mac": "bash make/macos/build-openvpn3.sh",
    "prepare:driver:win": "node make/windows/prepare-driver.mjs",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File make/windows/package.ps1",
    "package:mac": "bash make/macos/package.sh",
    "package:unified": "node install.mjs",
    "setup:unified": "node install.mjs --prepare-only",
    "test:unified": "node --test tests/*.test.mjs",
    "dist:win": "node make/tauri.mjs build --target x86_64-pc-windows-msvc --bundles nsis",
    "dist:mac": "node make/tauri.mjs build --bundles app,dmg",
    "verify:installer:win": "powershell -NoProfile -ExecutionPolicy Bypass -File make/windows/verify-installer.ps1",
    "predev": "npm run sync:branding && npm run check:stack",
    "prebuild": "npm run sync:branding && npm run check:stack"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
